# ── USAYEED Career API ─────────────────────────────────────
# Copy this file to `.env` and fill in your values.

PORT=4000

# Comma-separated list of browser origins allowed to POST the form.
ALLOWED_ORIGINS=https://usayeed.com,https://www.usayeed.com,http://localhost:3004

# Where uploaded CVs and the submission log are written.
UPLOAD_DIR=./uploads
DATA_FILE=./submissions.json

# Max CV size in bytes (default 5 MB).
MAX_CV_BYTES=5242880

# ── Optional email delivery ────────────────────────────────
# If these are set, every application is emailed to MAIL_TO with the CV attached.
# Leave blank to only store submissions on disk.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=info@usayeed.com
